exports[`#40: Spring Boot の生成物（database=postgresql） > 主なファイルの中身のスナップショット 1`] = `
{
  "backend/build.gradle.kts": "plugins {
    java
    alias(libs.plugins.spring.boot)
    alias(libs.plugins.spring.dependency.management)
}

group = "com.example.testapp001"
version = "0.0.1"

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(25)
    }
}

dependencies {
    implementation(libs.spring.boot.starter.actuator)
    implementation(libs.spring.boot.starter.webmvc)
    testImplementation(libs.spring.boot.starter.test)
    testImplementation(libs.spring.boot.starter.webmvc.test)
    testImplementation(libs.spring.boot.testcontainers)
    testImplementation(libs.testcontainers.junit.jupiter)
    testImplementation(libs.testcontainers.postgresql)
    testRuntimeOnly(libs.junit.platform.launcher)
    testRuntimeOnly(libs.postgresql)
}

tasks.withType<JavaCompile> {
    options.encoding = "UTF-8"
}

tasks.test {
    useJUnitPlatform()
}

tasks.named("check") {
    dependsOn("test")
}
",
  "backend/gradle/libs.versions.toml": "[versions]
spring-boot = "4.1.1"
spring-dependency-management = "1.1.7"

[libraries]
junit-platform-launcher = { module = "org.junit.platform:junit-platform-launcher" }
postgresql = { module = "org.postgresql:postgresql" }
spring-boot-starter-actuator = { module = "org.springframework.boot:spring-boot-starter-actuator" }
spring-boot-starter-test = { module = "org.springframework.boot:spring-boot-starter-test" }
spring-boot-starter-webmvc = { module = "org.springframework.boot:spring-boot-starter-webmvc" }
spring-boot-starter-webmvc-test = { module = "org.springframework.boot:spring-boot-starter-webmvc-test" }
spring-boot-testcontainers = { module = "org.springframework.boot:spring-boot-testcontainers" }
testcontainers-junit-jupiter = { module = "org.testcontainers:testcontainers-junit-jupiter" }
testcontainers-postgresql = { module = "org.testcontainers:testcontainers-postgresql" }

[plugins]
spring-boot = { id = "org.springframework.boot", version.ref = "spring-boot" }
spring-dependency-management = { id = "io.spring.dependency-management", version.ref = "spring-dependency-management" }
",
  "backend/settings.gradle.kts": "pluginManagement {
    repositories {
        mavenCentral()
    }
}

dependencyResolutionManagement {
    repositories {
        mavenCentral()
    }
}

rootProject.name = "testapp-001"
",
  "backend/src/main/java/com/example/testapp001/Application.java": "package com.example.testapp001;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

/** アプリの入口。 */
@SpringBootApplication
public class Application {

    public static void main(String[] args) {
        SpringApplication.run(Application.class, args);
    }
}
",
  "backend/src/main/java/com/example/testapp001/health/HealthController.java": "package com.example.testapp001.health;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

/** 動作の確認用の API。画面の「サーバーの状態」の表示が呼ぶ。Controller は入力の受付と応答だけにする。 */
@RestController
public class HealthController {

    /** 応答の形。画面の Health 型（status・appEnv）と合わせる。 */
    public record HealthResponse(String status, String appEnv) {}

    private final String appEnv;

    public HealthController(@Value("\${app.env}") String appEnv) {
        this.appEnv = appEnv;
    }

    @GetMapping("/api/health")
    public HealthResponse health() {
        return new HealthResponse("ok", appEnv);
    }
}
",
  "backend/src/main/resources/application.yaml": "server:
  # 画面の開発サーバー（Vite）の proxy の既定の接続先（http://localhost:8080）と合わせる
  port: 8080

spring:
  application:
    name: testapp-001

app:
  # 環境の名前。実際の環境では環境変数 APP_ENV で決める
  env: \${APP_ENV:development}
",
  "backend/src/main/resources/logback-spring.xml": "<?xml version="1.0" encoding="UTF-8"?>
<!-- ログの設定。Spring Boot の標準の書式（コンソール）を使う。出力先・形式を変えるときは、ここを直す -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
",
  "backend/src/test/java/com/example/testapp001/PostgresContainerTest.java": "package com.example.testapp001;

import static org.assertj.core.api.Assertions.assertThat;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import org.junit.jupiter.api.Test;
import org.testcontainers.junit.jupiter.Container;
import org.testcontainers.junit.jupiter.Testcontainers;
import org.testcontainers.postgresql.PostgreSQLContainer;

/**
 * Testcontainers で PostgreSQL を起動し、つながることを確かめる。Docker が動いている必要がある。
 * DB を使う機能のテストを書くときは、この形でコンテナを起動する。
 */
@Testcontainers
class PostgresContainerTest {

    @Container
    static final PostgreSQLContainer POSTGRES = new PostgreSQLContainer("postgres:18.6");

    @Test
    void コンテナが起動し_JDBCでつながる() throws SQLException {
        assertThat(POSTGRES.isRunning()).isTrue();
        try (Connection connection = DriverManager.getConnection(
                        POSTGRES.getJdbcUrl(), POSTGRES.getUsername(), POSTGRES.getPassword());
                Statement statement = connection.createStatement();
                ResultSet result = statement.executeQuery("select 1")) {
            assertThat(result.next()).isTrue();
            assertThat(result.getInt(1)).isEqualTo(1);
        }
    }
}
",
  "backend/src/test/java/com/example/testapp001/health/HealthControllerTest.java": "package com.example.testapp001.health;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
import org.springframework.test.web.servlet.MockMvc;

/** Controller だけを起動して確かめる（Docker は要らない）。 */
@WebMvcTest(value = HealthController.class, properties = "app.env=test")
class HealthControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @Test
    void healthは状態とappEnvを返す() throws Exception {
        mockMvc.perform(get("/api/health"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status").value("ok"))
                .andExpect(jsonPath("$.appEnv").value("test"));
    }
}
",
  "package.json": "{
  "name": "testapp-001",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/run-local.ts development vite",
    "build": "vite build",
    "preview": "node scripts/run-local.ts development vite preview",
    "predev": "npm run env:check -- development",
    "test": "node scripts/run-local.ts test vitest run",
    "pretest": "npm run env:check -- test",
    "check": "npm run check:app && npm run security",
    "check:app": "npm run test:safety && npm run lint && npm run typecheck && npm run format:check && npm run deps:check && npm run dup:check && npm test && npm run audit:prod",
    "security": "node scripts/security-check.mjs",
    "security:semgrep": "node scripts/security-check.mjs semgrep",
    "security:secrets": "node scripts/security-check.mjs secrets",
    "security:osv": "node scripts/security-check.mjs osv",
    "test:safety": "node scripts/test-safety.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise frontend/src --config .dependency-cruiser.cjs",
    "dup:check": "jscpd frontend/src",
    "mutation": "stryker run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "env:check": "node scripts/env-check.mjs"
  },
  "overrides": {
    "@typeschema/zod": {
      "zod": "$zod"
    }
  },
  "allowScripts": {
    "msw": false,
    "esbuild": true
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.0",
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jscpd": "5.3.3",
    "jsdom": "30.1.1",
    "msw": "3.0.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
",
  "tsconfig.json": "{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  // バックエンドは Java（backend/）のため、TypeScript の検査の対象は画面・スクリプト・設定ファイルだけ
  "include": ["frontend", "e2e", "scripts", "*.ts"]
}
",
  "vite.config.ts": "import react from "@vitejs/plugin-react";
import { defineConfig } from "vite";
import {
  applyLocalEnvironment,
  assertNoDevVars,
  clearInheritedEnvironment,
  loadLocalEnvironment,
  type LocalEnvironment,
} from "./scripts/local-env.ts";

// Vite の共通 .env 自動読込を止め、手元は明示した1環境だけを使う。
// バックエンドは Spring Boot（別のプロセス）。画面からの /api は、Vite の proxy でバックエンドへ中継する。
// 中継先の既定は http://localhost:8080（backend/src/main/resources/application.yaml の server.port と合わせる）。
// 変えるときは、.env.development に HARNESS_API_ORIGIN を書く。
export default defineConfig(({ command }) => {
  if (command === "build") {
    assertNoDevVars();
    clearInheritedEnvironment();
    return {
      envDir: "./node_modules/.harness-env-disabled",
      plugins: [react()],
    };
  }
  const environment = process.env.HARNESS_APP_ENV as LocalEnvironment;
  const values = loadLocalEnvironment(environment);
  applyLocalEnvironment(values);
  console.log(\`環境：\${environment}\`);
  const proxy = {
    "/api": {
      target: process.env.HARNESS_API_ORIGIN ?? "http://localhost:8080",
    },
  };
  return {
    envDir: "./node_modules/.harness-env-disabled",
    plugins: [react()],
    server: { proxy },
    preview: { proxy },
  };
});
",
  "vitest.config.ts": "import react from "@vitejs/plugin-react";
import { defineConfig } from "vitest/config";
import {
  applyLocalEnvironment,
  loadLocalEnvironment,
} from "./scripts/local-env.ts";

const values = loadLocalEnvironment("test");
applyLocalEnvironment(values);

// バックエンドは Java（Spring Boot、backend/ の ./gradlew check）。ここでは画面（フロントエンド）だけを jsdom で動かす
export default defineConfig({
  envDir: "./node_modules/.harness-env-disabled",
  test: {
    projects: [
      {
        plugins: [react()],
        test: {
          name: "frontend",
          include: ["frontend/**/*.test.{ts,tsx}"],
          environment: "jsdom",
          setupFiles: ["./frontend/src/test/setup.ts"],
        },
      },
    ],
  },
});
",
}
`;
